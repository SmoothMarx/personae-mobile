{
  "expo": {
    "name": "Personae",
    "slug": "personae-mobile",
    "version": "0.14.0",
    "orientation": "default",
    "scheme": "personae",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personae.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Personae connects to the Hermes gateway on your own network, so it needs permission to reach devices on your local network.",
        "NSPhotoLibraryUsageDescription": "Personae opens your photo library only when you choose a picture to send."
      }
    },
    "android": {
      "package": "com.personae.mobile",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Personae uses the microphone only to record a voice note you hold the mic button to send."
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "./modules/tailscale-trigger/app.plugin.js",
        {
          "packages": [
            "com.tailscale.ipn"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Personae uses the camera only to scan the pairing QR code on your Hermes dashboard.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Personae opens your photo library only when you choose a picture to send."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
