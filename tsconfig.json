{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*", "app/**/*", "tests/**/*", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "dist"]
}
